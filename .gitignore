.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mutmut-cache
mutants/
.hypothesis/
.tox/
.nox/

# --- Type checking and linting caches ---
.mypy_cache/
.ruff_cache/
.pyre/

