# --- Secrets and local config: never commit ---
.envrc
.env
.env.*
!.env.example
!.envrc.example
*.pem
*.key
*.p12
secrets/
config.local.*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

