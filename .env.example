# Seriatim runtime configuration: placeholders only. Copy to .env, or set these in the
# service environment. Real values never go in the repository.
#
# Sidecar (docs/design/TD-slice-1.md §6). Every key is SERIATIM_NODE_<FIELD>; the same names,
# lower-case and without the prefix, can be set in the TOML file named by SERIATIM_NODE_CONFIG.
# Environment variables take precedence. Shown with their defaults.

# SERIATIM_NODE_LISTEN_HOST=127.0.0.1
# SERIATIM_NODE_LISTEN_PORT=11434
# SERIATIM_NODE_OLLAMA_URL=http://127.0.0.1:11435
# SERIATIM_NODE_ID=node
# SERIATIM_NODE_SLOTS=1
# SERIATIM_NODE_RETRY_AFTER_S=15
# SERIATIM_NODE_DRAIN_S=10
# SERIATIM_NODE_MAX_HOLD_S=1800
# SERIATIM_NODE_CONNECT_TIMEOUT_S=5
# SERIATIM_NODE_CLOSE_TIMEOUT_S=5
# SERIATIM_NODE_UNGATED_READ_TIMEOUT_S=300
# SERIATIM_NODE_MAX_BODY_BYTES=67108864
# SERIATIM_NODE_BODY_TIMEOUT_S=30
# SERIATIM_NODE_HEALTH_PROBE_TIMEOUT_S=2
# SERIATIM_NODE_ALLOW_UNAUTHENTICATED=false
# SERIATIM_NODE_LOCK_DIR=  # default: per OS (TD §2.1)
# SERIATIM_NODE_LOG_LEVEL=INFO
# SERIATIM_NODE_CONFIG=

# The gateway's settings (SERIATIM_GW_*) arrive with slice S7.
